---
// components
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";
import Dropdown from "../../elements/Dropdown.astro";
import ContainerBottom from "../../elements/ContainerBottom.astro";

// content
const services = [
    {
        title: "Live Sound",
        text: "Professional live mixing and stage sound for concerts, venues, festivals and events."
    },
    {
        title: "Studio Recording",
        text: "Basement recording sessions for singer-songwriters."
    },
    {
        title: "Mixing / Mastering",
        text: "I turn your recordings into finished, balanced tracks that are ready to be released."
    },
    {
        title: "Music Video",
        text: "I can help you create a music video. You tell me your vision and I'll put together the crew and do all the editing work."
    },
]
---

<Container variant={'md'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">Services</Heading>
    <div class="flex flex-col gap-4">
        <Container class="flex flex-col gap-4 p-6 border-3 border-base-900">
            {
                services.map((service, index) => (
                    <Dropdown title=`${index + 1}. ${service.title}` text={service.text} />  
                ))
            }       
        </Container>
        <ContainerBottom />    
    </div>

</Container>