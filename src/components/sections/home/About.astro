---
// components
import Heading from "../../elements/Heading.astro";
import Text from "../../elements/Text.astro";
import Container from "../../elements/Container.astro";
import Link from "../../elements/Link.astro";
import ImageContainer from "../../elements/ImageContainer.astro";

// assets
import bass from "../../../assets/images/bass.jpeg";
---

<Container variant={"xl"}>
  <Heading tagName="h2" tagSize="h2" class="text-center">About</Heading>
  <div class="flex lg:flex-row lg:gap-16 gap-10 flex-col">
    <div
      class="flex flex-col items-start gap-6 lg:pt-6 text-base-900 lg:flex-1"
    >
      <Text variant={"xl"}
        >I’m Martijn — a sound engineer, producer and musician from Ghent,
        Belgium.</Text
      >
      <Text variant={"sm"}
        >I work on pretty much anything where music, sound and technology meet.
        That means mixing live shows, recording and producing artists, making
        music videos, and generally figuring out how to make things sound
        better.</Text
      >
      <Link variant={"button"} href="/sound/about">More about me</Link>
    </div>
    <div class="w-full lg:h-[500px] h-auto lg:flex-1">
      <ImageContainer src={bass} alt="Peter Jones" />
    </div>
  </div>
</Container>
