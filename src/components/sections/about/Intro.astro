---
// components
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";
import Text from "../../elements/Text.astro";
import ImageContainer from "../../elements/ImageContainer.astro";

// assets
import peter from "../../../assets/images/martijn.png";
---

<Container variant={"xl"}>
  <Heading tagName="h1" tagSize="h1" class="text-center">Martijn</Heading>
  <div class="flex md:flex-row flex-col gap-16 md:items-center">
    <div class="flex-1 flex flex-col gap-7">
      <Text variant={"xl"} class="text-base-900"
        >Hey, I’m Martijn — a sound engineer, producer and musician from Ghent,
        Belgium.
      </Text>
      <Text variant={"sm"} class="text-base-900">
        I work on pretty much anything where music, sound and technology meet.
        That means mixing live shows, recording and producing artists, making
        music videos, and generally figuring out how to make things sound
        better. <br />I started out in software development, but music has
        always been the thing I kept coming back to. These days, I get to
        combine both sides of my brain: the technical stuff and the creative
        stuff. I play drums, guitar, piano and trumpet, make music myself, and
        spend way too much time messing around with audio gear and production. I
        like working with people who care about what they're making. Whether
        you're playing your first proper show, recording a song you've been
        sitting on for months, or just have an idea you want to turn into
        something real — I'm here to help make it happen.</Text
      >
    </div>
    <div class="flex-1 md:h-[500px] w-full">
      <ImageContainer src={peter} alt="Peter" />
    </div>
  </div>
</Container>
